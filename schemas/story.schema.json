{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["github-copilot-local-sandbox-ga","github-copilot-cli-ollama-local-models","docker-cloud-sandboxes-sandbox-kit","kubernetes-cgroup-v2-failcgroupv1-default-v1-35","csharp-dev-kit-11-performance-rearchitecture","kubernetes-node-swap-ga-v1-34","argocd-3-5-4-release","dotnet-11-rc1-go-live","postgresql-19-release-schedule"]
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "firstSeen": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastReported": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "sourceType": {
          "enum": [
            "official",
            "repository",
            "documentation",
            "community"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
        },
        "reportPath": {
          "type": "string",
          "pattern": "^reports/\\d{4}/\\d{4}-\\d{2}-\\d{2}\\.md$"
        },
        "maturity": {
          "enum": [
            "Experimental",
            "Preview",
            "Production Ready"
          ]
        },
        "recommendation": {
          "enum": [
            "Try",
            "Watch",
            "Skip"
          ]
        },
        "updateOf": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "product",
        "event",
        "firstSeen",
        "lastReported",
        "status",
        "tags",
        "sourceType",
        "sourceUrl",
        "reportPath"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "firstSeen": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastReported": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "sourceType": {
          "enum": [
            "official",
            "repository",
            "documentation",
            "community"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
        },
        "reportPath": {
          "type": "string",
          "pattern": "^reports/\\d{4}/\\d{4}-\\d{2}-\\d{2}\\.md$"
        },
        "maturity": {
          "enum": [
            "Experimental",
            "Preview",
            "Production Ready"
          ]
        },
        "recommendation": {
          "enum": [
            "Try",
            "Watch",
            "Skip"
          ]
        },
        "updateOf": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schemaVersion": {
          "const": 2
        },
        "productKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "eventKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "milestone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "coverage": {
          "enum": [
            "NEW",
            "UPDATE"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "evidenceSummary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "materialChange": {
          "enum": [
            "milestone",
            "release",
            "breaking-change",
            "security",
            "benchmark",
            "adoption",
            "clarification",
            "capability",
            "performance"
          ]
        },
        "toolIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "dedupeReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matchedId", "reason", "reviewedAt"],
          "properties": {
            "matchedId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "reason": {"type": "string", "minLength": 20, "pattern": "\\S"},
            "reviewedAt": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "id",
        "product",
        "event",
        "firstSeen",
        "lastReported",
        "status",
        "tags",
        "sourceType",
        "sourceUrl",
        "reportPath",
        "schemaVersion",
        "productKey",
        "eventKey",
        "milestone",
        "coverage",
        "publishedAt",
        "evidenceSummary"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "UPDATE"
              }
            }
          },
          "then": {
            "required": [
              "updateOf",
              "changeSummary",
              "materialChange"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "updateOf"
                  ]
                },
                {
                  "required": [
                    "materialChange"
                  ]
                },
                {
                  "required": [
                    "changeSummary"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
