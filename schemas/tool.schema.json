{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
    },
    "repositoryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "firstSeen": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "aliases",
    "homepage",
    "tags",
    "firstSeen"
  ],
  "additionalProperties": false
}
